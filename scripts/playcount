#!/bin/bash
TARGET="${PREV_SONG:-$FILE}"
ELAPSED="${PREV_ELAPSED:-0}"

# If triggered by song change with a previous song, only increment if listened >= 20s
if [ -n "$PREV_SONG" ] && [ "${ELAPSED%%.*}" -lt 20 ]; then
    exit 0
fi

[ -z "$TARGET" ] && exit 0

CURRENT=$(rmpc sticker get "$TARGET" playCount 2>/dev/null | jq -r '.value // 0' 2>/dev/null || echo 0)
[[ "$CURRENT" =~ ^[0-9]+$ ]] || CURRENT=0

rmpc sticker set "$TARGET" playCount $((CURRENT + 1))
